{
  "name": "transa",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && bun apps/mobile/sync-version.js",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev": "concurrently -c \"cyan.bold,magenta.bold\" -n \"API,WEB\" \"bun run dev:api\" \"bun run dev:web\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "web": "^0.0.2",
    "zod": "^4.4.3"
  }
}
